{
  "expo": {
    "name": "e-consolatrix",
    "slug": "e-consolatrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bg2.png",
    "backgroundColor": "#ffffff",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bg2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.leonises.econsolatrix"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bg2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "752953bb-ab9c-4dae-8b8c-999b4b741c75"
      }
    }
  }
}